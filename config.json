{
  "project": {
    "name": "teko-ajaib",
    "version": "1.0.0",
    "description": "Financial Index Forecasting with Dual-Head LSTM and Intermarket Features"
  },
  "data": {
    "target_ticker": "QQQ",
    "candidate_tickers": [
      "QQQ", "AAPL", "NVDA", "MSFT", "AMZN",
      "AMD", "MU", "TSLA", "META", "GOOGL", "AVGO", "VIX"
    ],
    "price_tickers": [
      "QQQ", "AAPL", "MSFT", "GOOGL", "AMZN",
      "META", "TSLA", "AMD", "NVDA", "AVGO", "VIX"
    ],
    "start_train_date": "2015-01-01",
    "split_date": "2026-06-30",
    "forward_test_start": "2026-07-01",
    "correlation_threshold": 0.85,
    "use_technical_indicators": true,
    "include_vix": true
  },
  "model": {
    "architecture": "DualHeadLSTM",
    "hidden_size": 64,
    "num_layers": 2,
    "dropout": 0.2
  },
  "training": {
    "seq_len": 10,
    "batch_size": 32,
    "num_epochs": 40,
    "learning_rate": 0.001,
    "weight_decay": 0.001,
    "early_stopping_patience": 12,
    "val_split_ratio": 0.20,
    "seed": 42
  },
  "loss": {
    "alpha": 1.0,
    "beta": 0.5
  },
  "evaluation": {
    "target_directional_accuracy": 70.0,
    "confidence_margin": 0.05
  },
  "forecasting": {
    "forecast_days": 5,
    "confidence_level": 0.95
  },
  "paths": {
    "base_dir": ".",
    "data_dir": "data",
    "raw_data_dir": "data/raw",
    "raw_data_filename": "qqq_daily_cross_asset_2000_2026.csv",
    "models_dir": "models",
    "reports_dir": "reports"
  }
}
